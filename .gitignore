# Explicitly keep heavy generated artifacts ignored
results/stage24_evidence/**/*.pt
results/stage24_evidence/**/*.pth
results/stage24_evidence/**/*.ckpt
results/stage24_evidence/**/*.npz
results/stage24_evidence/**/*.npy
results/stage24_evidence/**/*.joblib
results/stage24_evidence/**/*.pid
results/stage24_evidence/**/*.lock
results/stage24_evidence/**/*.log

